FROM ubuntu:22.04

# Evitar diálogos durante la instalación
ENV DEBIAN_FRONTEND=noninteractive
ENV QT_QPA_PLATFORM=offscreen

# Instalar dependencias del sistema y Python 3.10 (nativo de Ubuntu 22.04)
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3.10-venv \
    python3-pip \
    libglib2.0-0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxcb-xfixes0 \
    libxcb-xinerama0 \
    libxcb1 \
    libxkbcommon-x11-0 \
    libdbus-1-3 \
    libgl1-mesa-glx \
    libegl1 \
    libxcb-cursor0 \
    libgtk-3-0 \
    libpangocairo-1.0-0 \
    libpango-1.0-0 \
    libgdk-pixbuf-2.0-0 \
    libharfbuzz0b \
    && rm -rf /var/lib/apt/lists/*

# Definir directorio de trabajo
WORKDIR /app

# Copiar el contenido del proyecto
# Asegúrate de ejecutar el build desde la raíz donde está beatboard-linux.spec
COPY . .

# Crear entorno virtual e instalar dependencias de Python
RUN python3.10 -m venv .venv && \
    .venv/bin/pip install --upgrade pip && \
    .venv/bin/pip install pyside6 pyinstaller spylls

# Ejecutar PyInstaller
# Usamos --workpath y --distpath para tener control total
RUN .venv/bin/pyinstaller beatboard-linux.spec --clean --noconfirm

# Preparar la salida
RUN mkdir -p /build/output && \
    cp dist/BeatBoard_portable /build/output/ && \
    cp -r dist/BeatBoard_appdir /build/output/
